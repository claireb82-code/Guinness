{
  "name": "guinness-finder",
  "version": "1.0.0",
  "description": "Locate hotels, bars, pubs, and restaurants via Google Maps, inspect menus & reviews for Guinness, and crowdsource pint quality.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "client": "vite",
    "build": "vite build",
    "start": "python3 app_server.py",
    "test": "python3 -m unittest && npm run test:js",
    "test:py": "python3 -m unittest",
    "test:js": "node --test \"tests/js/*.test.js\"",
    "test:e2e": "vite build && node --test \"tests/e2e/*.e2e.mjs\""
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "leaflet": "1.9.4",
    "vite": "^5.4.8"
  }
}
