{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{app_server.py,guard.py,storage.py,overture.py,public/**,src/styles.css,server/data/swiss_crawl_results.json,server/data/overture_ch.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/src/styles.css",
      "destination": "/api/index.py"
    },
    {
      "source": "/standalone",
      "destination": "/standalone.html"
    }
  ]
}
