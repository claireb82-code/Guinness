# ---------------------------------------------------------------------------
# Local development: copy to .env (it is git-ignored). On Vercel, set these in
# Project Settings -> Environment Variables instead. See README "Deploying to Vercel".
# ---------------------------------------------------------------------------
PORT=3000

# --- Google keys: use TWO different keys for anything deployed ----------------
# Browser key: sent to every visitor to draw the Google basemap. Restrict it in Google Cloud to the
# "Maps JavaScript API" and to your site's HTTP referrers.
GOOGLE_MAPS_BROWSER_KEY=

# Server key: used only by the server for Places API (New) calls and NEVER sent to browsers.
# Restrict it to "Places API (New)". On a public deployment it is not used for anonymous visitors
# unless ALLOW_PUBLIC_GOOGLE_LIVE=1 (visitors can still paste their own key in the app).
GOOGLE_PLACES_API_KEY=
# ALLOW_PUBLIC_GOOGLE_LIVE=1

# Legacy single key: honoured for LOCAL development only (and by scripts/*.py). Ignored on Vercel,
# where it used to be exposed through /api/config - restrict or rotate it if you ever set it there.
GOOGLE_MAPS_API_KEY=

# --- Community data storage (Vercel: add "Upstash Redis" from Storage/Marketplace) ---
# Without these, community reports / venues are file-based locally and DISABLED on Vercel.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted too.)
# GUINNESS_KEY_PREFIX=guinness:

# --- Rate limits per client IP (defaults shown) ---
# RATE_LIMIT_WRITES_PER_HOUR=10
# RATE_LIMIT_SCANS_PER_10MIN=120
# RATE_LIMIT_GOOGLE_PER_10MIN=15
# RATE_LIMIT_HEAVY_PER_10MIN=3

# --- Overpass (OpenStreetMap area scans), all optional: see README "Live area scans" ---
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# OVERPASS_ATTEMPT_SECONDS=18
# OVERPASS_DEADLINE_SECONDS=40
# OVERPASS_ROUNDS=2
# OVERPASS_CACHE_SECONDS=300

